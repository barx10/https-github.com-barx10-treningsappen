# Environment Variables

# PIN-kode for å beskytte appen (valgfritt)
# Hvis satt, må brukere skrive inn PIN for å få tilgang
# La stå tom for å deaktivere PIN-beskyttelse
VITE_APP_PIN=

# Supabase (valgfritt - kreves for sky-backup og innlogging)
# Finnes i Supabase-dashboardet under Project Settings -> API.
# VITE_SUPABASE_KEY er den offentlige anon-nøkkelen (aldri service_role-nøkkelen!).
# Husk å kjøre supabase/schema.sql i SQL Editor før første synk.
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# AI Provider Selection
# Options: 'gemini' (default) or 'openai'
AI_PROVIDER=gemini

# Gemini API Key (Google AI Studio)
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model (default: gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash

# Optional: how much the model "thinks" - MINIMAL | LOW | MEDIUM | HIGH (default: LOW)
# GEMINI_THINKING_LEVEL=LOW

# OpenAI API Key (optional - only needed if AI_PROVIDER=openai)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: override the OpenAI model (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Optional: restrict CORS on the API routes (default: * )
# ALLOWED_ORIGIN=https://din-app.vercel.app
